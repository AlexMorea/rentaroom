# Copy this file to .env and fill in real values for local development.
# Nothing here is a real secret - these are just examples/placeholders.

# ----------------- Core -----------------
# "1" for local development (relaxes HTTPS/cookie security, allows a
# generated SECRET_KEY). Leave unset or "0" for anything resembling
# production - SECRET_KEY becomes required when this is off.
DEBUG=1

# Required when DEBUG is not "1". Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated extra hosts, e.g. "rooms4you.co.za,www.rooms4you.co.za"
ALLOWED_HOSTS=

# ----------------- Database / cache -----------------
# Leave unset to use the local sqlite3 fallback (db.sqlite3).
DATABASE_URL=

# Leave unset to use Django's local in-memory cache.
REDIS_URL=

# ----------------- Media storage (Cloudinary) -----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------- Third-party integrations -----------------
GOOGLE_MAPS_API_KEY=
GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=

# ----------------- Transactional email (Brevo) -----------------
BREVO_API_KEY=
BREVO_SENDER_NAME=Rooms4You
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_FROM_NAME=Rooms4You

# Where new fraud reports are emailed for staff triage.
SAFETY_TEAM_EMAIL=safety@rooms4you.co.za

# ----------------- Google Sign-In -----------------
# "Continue with Google" on login/register. Leave blank to hide the
# button entirely - see rentaroom/settings.py for where to get this.
GOOGLE_OAUTH_CLIENT_ID=

# ----------------- Automated lifecycle nudges -----------------
LANDLORD_NO_LISTING_NUDGE_DAYS=3
PLACEMENT_STALL_DAYS=7

# ----------------- Web Push (VAPID) -----------------
# Leave both unset for local dev - a throwaway keypair is generated at
# startup automatically. For production, run:
#   python manage.py generate_vapid_keys
# once, then set both here permanently. Rotating them later invalidates
# every push subscription already collected.
VAPID_PRIVATE_KEY_PEM=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=safety@rooms4you.co.za

# ----------------- Android app (Trusted Web Activity) -----------------
# Leave both unset until you've generated mobile/android's signing
# keystore (see mobile/android/README.md). Powers
# /.well-known/assetlinks.json, which is what lets the Play Store app
# open rooms4you.co.za links without browser chrome.
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINTS=

# ----------------- Background jobs (optional) -----------------
# Leave unset to disable Celery entirely - the app runs fine without it.
CELERY_BROKER_URL=

# ----------------- Feature flags -----------------
# Room ranking cache threshold; only change if you know why.
POPULAR_SCORE_THRESHOLD=100
USE_MATERIALIZED_SCORE=True

# ----------------- Listing Freshness -----------------
# Days without a landlord confirming a listing before it gets a "please
# confirm" nudge, and before it's auto-hidden if nobody responds.
LISTING_STALE_DAYS=14
LISTING_AUTO_HIDE_DAYS=30

# "1" to actually suspend landlord accounts with a 14+ day overdue
# Success Fee. Defaults to off (reports what it would do) on purpose -
# see the comment above this setting in rentaroom/settings.py.
PLACEMENT_FEE_AUTO_SUSPEND=0
